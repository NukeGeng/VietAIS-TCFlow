# Image/version settings
TCFLOW_VERSION=2.0.4-rc
TCFLOW_IMAGE_PREFIX=vietais-tcflow
TCFLOW_HTTP_PORT=8080
TCFLOW_PUBLIC_URL=http://localhost:8080

# PostgreSQL (do not use these defaults for a shared or internet-facing host)
POSTGRES_DB=vietais_tcflow
POSTGRES_USER=tcflow
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application secrets (use unique random values, never commit the real .env)
JWT_KEY=replace-with-a-long-random-jwt-key
HANGFIRE_USERNAME=admin
HANGFIRE_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# GitHub App is optional until GitHub integration is enabled.
GITHUB_APP_ID=0
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/github/callback
GITHUB_WEBHOOK_SECRET=

# Deep reasoning is opt-in. The API image does not bundle the Codex executable.
REPOSITORY_REASONING_ENABLED=false
REPOSITORY_REASONING_EXECUTABLE=codex
REPOSITORY_REASONING_WORKING_DIRECTORY=.tcflow/codex-reasoning
# Empty uses the authenticated managed account's default model.
REPOSITORY_REASONING_MODEL=
