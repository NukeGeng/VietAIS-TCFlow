# syntax=docker/dockerfile:1

FROM node:24.19-alpine AS build
WORKDIR /app

COPY src/apps/vue/package.json src/apps/vue/package-lock.json ./
RUN npm ci

COPY src/apps/vue/ ./
RUN npm run build

FROM nginx:1.29-alpine AS runtime
COPY deploy/self-host/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget --quiet --spider http://localhost:8080/ || exit 1
